# Railway Postgres (im Railway-Projekt per Referenz: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres@localhost:5432/poppsie

# Öffentliche URL der App (für E-Mail-Links)
APP_URL=http://localhost:3000

# Railway Bucket (S3-kompatibel, privat). Ohne diese Variablen wird lokal in .uploads/ gespeichert.
BUCKET=
ENDPOINT=
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=

# Resend (Aktivierungscodes). Ohne Key wird der Code im Server-Log ausgegeben.
RESEND_API_KEY=
MAIL_FROM="Poppsie <noreply@example.com>"

# 32 Byte hex/base64 – verschlüsselt Präferenzen (AES-256-GCM) und signiert Medien-URLs
APP_SECRET=change-me-to-a-long-random-string

# Cloudflare Turnstile (optional; ohne Secret wird die Prüfung übersprungen)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin-Bootstrap: dieser Benutzername erhält beim Start die Rolle admin
ADMIN_USERNAME=
